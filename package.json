{ "name": "evm-transactions-tools",
  "version":
    "0.0.1111111",
  "description":
    "Programs and libraries to interact with Ethereum Virtual Machine (EVM) networks transactions in native computer applications, in particular those written using the LibEVM library and using the EVM Contracts Tools.",
  "funding": {
    "type":
      "patreon",
    "url":
      "https://patreon.com/tallero"
  },
  "man": [
    "./man/evm-transaction-get.1"
  ],
  "files": [
    "AUTHORS.rst",
    "COPYING",
    "README.md",
    "dist",
    "lib",
    "evm-transactions-tools",
    "fs-worker.webpack.config.js",
    "package.json",
    "serve.json",
    "webpack.config.js"
  ],
  "keywords": [
    "ur",
    "themartiancompany",
    "dogeos",
    "ethereum",
    "evmfs",
    "libevm",
    "evm-toolchain"
  ],
  "homepage":
    "https://github.com/themartiancompany/evm-transactions-tools",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/evm-transactions-tools/issues"
  },
  "repository": {
    "type":
      "git",
    "url":
      "git+https://github.com/themartiancompany/evm-transactions-tools.js.git"
  },
  "license":
    "AGPL-3.0-or-later",
  "author": {
    "name":
      "Pellegrino Prevete",
    "email":
      "pellegrinoprevete@gmail.com",
    "url":
      "https://github.com/tallero"
  },
  "devDependencies": {
    "crash-js-webpack":
      "^0.0.68",
    "brace-expansion":
      "^5.0.9",
    "eslint":
      "^10.9.0",
    "fast-uri":
      "^4.1.2",
    "globals":
      "^17.3.0",
    "@eslint/js":
      "^10.0.1",
    "safely-serve":
      "^0.0.18",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^10000000000001.1000000000000001.1000000000000001",
    "evm-wallet":
      "npm:evm-wallet.js@^0.0.86",
    "yargs":
      "18.0.0"
  },
  "overrides": {
    "evm-transactions-tools":
      "./evm-transactions-tools",
    "libevm":
      "^0.0.37"
  },
  "type":
    "module",
  "main":
    "evm-transactions-tools",
  "bin": {
    "receipt":
      "lib/transaction-receipt-get",
    "transaction":
      "lib/transaction-get",
    "transaction-get":
      "lib/transaction-get",
    "transaction-info":
      "lib/transaction-get",
    "transaction-receipt":
      "lib/transaction-receipt-get",
    "transaction-receipt-get":
      "lib/transaction-receipt-get",
    "tx":
      "lib/transaction-get"
  },
  "scripts": {
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details && cp 'fs-worker.js' 'dist/evm-transactions-tools'",
    "build-lib":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && mv 'evm-transactions-tools.js' 'dist/evm-transactions-tools'",
    "build":
      "npm run lint && npm run build-fs-worker && npm run build-lib",
    "lint":
      "npx eslint .",
    "publish-pnm":
      "npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/evm-transaction-tools'",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
